 "lines": [
  {
   "id": "h1",
   "scene": "hook",
   "t0": 0.0,
   "t1": 3.6,
   "text": "最右边这颗{智齿}，|横着卡在了下巴里"
  },
  {
   "id": "h2",
   "scene": "hook",
   "t0": 3.9,
   "t1": 7.169,
   "text": "如今，大约{每 4 个人}|就有 1 个这样的"
  },
  {
   "id": "h3",
   "scene": "hook",
   "t0": 7.469,
   "t1": 10.416,
   "text": "可在工业化以前：|{不到 1/20}"
  },
  {
   "id": "h4",
   "scene": "hook",
   "t0": 10.716,
   "t1": 13.502,
   "text": "原始人的下巴，|凭什么{放得下}？"
  },
  {
   "id": "l1",
   "scene": "lot",
   "t0": 15.002,
   "t1": 18.432,
   "text": "把下巴想成一排{停车位}：|一颗牙，占一个"
  },
  {
   "id": "l2",
   "scene": "lot",
   "t0": 18.732,
   "t1": 23.132,
   "text": "牙按顺序进场：|{6 岁}、{12 岁}各来一颗大磨牙"
  },
  {
   "id": "l3",
   "scene": "lot",
   "t0": 23.432,
   "t1": 28.032,
   "text": "{智齿}是第三颗大磨牙，|排最后：{18～25 岁}才到"
  },
  {
   "id": "l4",
   "scene": "lot",
   "t0": 28.332,
   "t1": 31.44,
   "text": "来得太晚，|后面的墙堵着——{车位已满}"
  },
  {
   "id": "l5",
   "scene": "lot",
   "t0": 31.74,
   "t1": 35.94,
   "text": "挤不进去，就斜着卡在半路：|这叫{阻生}"
  },
  {
   "id": "l6",
   "scene": "lot",
   "t0": 36.24,
   "t1": 41.04,
   "text": "卡住的地方容易塞{食物}、闹{发炎}，|还会顶坏前面那颗牙"
  },
  {
   "id": "l7",
   "scene": "lot",
   "t0": 41.34,
   "t1": 44.448,
   "text": "毛病不在智齿，|在于{停车场修小了}"
  },
  {
   "id": "p1",
   "scene": "past",
   "t0": 45.948,
   "t1": 50.348,
   "text": "原始人的下巴更{长}：|车位够，智齿能{正着长出来}"
  },
  {
   "id": "p2",
   "scene": "past",
   "t0": 50.648,
   "t1": 54.848,
   "text": "阻生智齿从{不到 5%}涨到{约 25%}，|只用了两百年"
  },
  {
   "id": "p4",
   "scene": "past",
   "t0": 55.148,
   "t1": 58.095,
   "text": "这么短，基因来不及变。|变的是{饭}"
  },
  {
   "id": "p5",
   "scene": "past",
   "t0": 58.395,
   "t1": 63.595,
   "text": "从生根茎、硬肉干，到面包、粥、奶茶：|越来越{不用嚼}"
  },
  {
   "id": "s2",
   "scene": "site",
   "t0": 64.995,
   "t1": 69.995,
   "text": "下巴小时候{边长边扩建}：|后墙一点点往后挪，给新磨牙{腾地方}"
  },
  {
   "id": "s3",
   "scene": "site",
   "t0": 70.295,
   "t1": 74.895,
   "text": "工地看信号干活：|每嚼一口，就是一次{开工信号}"
  },
  {
   "id": "s4",
   "scene": "site",
   "t0": 75.195,
   "t1": 78.626,
   "text": "原始人小孩天天啃硬的，|工地{开足马力}"
  },
  {
   "id": "s5",
   "scene": "site",
   "t0": 78.926,
   "t1": 82.195,
   "text": "现代小孩吃得软，信号少，|工地{没活干}"
  },
  {
   "id": "s6",
   "scene": "site",
   "t0": 82.495,
   "t1": 85.765,
   "text": "下巴少长了一截，|{智齿的车位}就没了"
  },
  {
   "id": "r1",
   "scene": "rats",
   "t0": 87.065,
   "t1": 89.665,
   "text": "这在{大鼠}身上做过实验："
  },
  {
   "id": "r2",
   "scene": "rats",
   "t0": 89.965,
   "t1": 94.565,
   "text": "同一种饲料，一组啃{硬颗粒}，|一组吃{泡软的糊}"
  },
  {
   "id": "r3",
   "scene": "rats",
   "t0": 94.865,
   "t1": 98.456,
   "text": "60 天后，吃糊那组的下巴|{短了约 16%}"
  },
  {
   "id": "r4",
   "scene": "rats",
   "t0": 98.756,
   "t1": 103.756,
   "text": "世界各地的头骨也这样：|狩猎采集者的下巴，比种地的{更长}"
  },
  {
   "id": "w1",
   "scene": "wear",
   "t0": 105.056,
   "t1": 108.648,
   "text": "还有一招：粗粮里带着沙，|会把牙{磨小}一点"
  },
  {
   "id": "w2",
   "scene": "wear",
   "t0": 108.948,
   "t1": 113.748,
   "text": "前面的牙磨短了，整排{往前挪}，|后面就空出了车位"
  },
  {
   "id": "w3",
   "scene": "wear",
   "t0": 114.048,
   "t1": 116.995,
   "text": "如今的牙几乎不磨，|也就{不挪}了"
  },
  {
   "id": "m1",
   "scene": "mismatch",
   "t0": 118.195,
   "t1": 120.595,
   "text": "这就是{进化错配}："
  },
  {
   "id": "m2",
   "scene": "mismatch",
   "t0": 120.895,
   "t1": 125.895,
   "text": "牙还按 {32 颗}的老配置长，|很多人的下巴只修了 {28 个车位}"
  },
  {
   "id": "g1",
   "scene": "guide",
   "t0": 127.295,
   "t1": 129.895,
   "text": "那长了智齿怎么办？"
  },
  {
   "id": "g2",
   "scene": "guide",
   "t0": 130.195,
   "t1": 135.595,
   "text": "先{拍片}，让牙医看：|长正了、不疼、刷得干净的，可以{先观察}"
  },
  {
   "id": "g3",
   "scene": "guide",
   "t0": 135.895,
   "t1": 138.842,
   "text": "反复{发炎}、顶坏邻牙的，|{该拔就拔}"
  },
  {
   "id": "g4",
   "scene": "guide",
   "t0": 139.142,
   "t1": 144.342,
   "text": "给孩子多吃点要嚼的？{可能}有帮助，|但人身上的证据{还不多}"
  },
  {
   "id": "e0",
   "scene": "end",
   "t0": 145.442,
   "t1": 148.042,
   "text": ""
  },
  {
   "id": "e1",
   "scene": "end",
   "t0": 148.342,
   "t1": 151.289,
   "text": "车位不够，|是因为我们{嚼得太少}"
  }
 ]
}