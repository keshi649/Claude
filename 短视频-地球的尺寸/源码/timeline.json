 ],
 "lines": [
  {
   "id": "o1",
   "scene": "open",
   "t0": 1.4,
   "t1": 5.6,
   "text": "沿着经线绕地球一圈，约 {40 000} 公里。"
  },
  {
   "id": "o2",
   "scene": "open",
   "t0": 5.92,
   "t1": 9.32,
   "text": "整整齐齐，像是有人{故意凑}的。"
  },
  {
   "id": "o3",
   "scene": "open",
   "t0": 9.64,
   "t1": 12.24,
   "text": "——确实有人。"
  },
  {
   "id": "o4",
   "scene": "open",
   "t0": 12.56,
   "t1": 16.76,
   "text": "不过故事，得从两千多年前的一根{木棍}说起。"
  },
  {
   "id": "o5",
   "scene": "open",
   "t0": 17.08,
   "t1": 20.08,
   "text": "那时没有卫星，没有飞机——"
  },
  {
   "id": "o6",
   "scene": "open",
   "t0": 20.4,
   "t1": 24.8,
   "text": "地球有多大，能用一道{影子}量出来吗？"
  },
  {
   "id": "e1",
   "scene": "era1",
   "t0": 33.7,
   "t1": 38.3,
   "text": "夏至正午，南方的赛伊尼，阳光直直照进{井底}。"
  },
  {
   "id": "e2",
   "scene": "era1",
   "t0": 38.62,
   "t1": 43.22,
   "text": "同一时刻，北边的亚历山大，木棍却投下一小段{影子}。"
  },
  {
   "id": "e3",
   "scene": "era1",
   "t0": 43.54,
   "t1": 48.14,
   "text": "影子的角度：{7.2°}，正好是一整圈的 {1/50}。"
  },
  {
   "id": "e4",
   "scene": "era1",
   "t0": 48.46,
   "t1": 53.26,
   "text": "阳光是平行的——这也是两座城在{地心}张开的角。"
  },
  {
   "id": "e5",
   "scene": "era1",
   "t0": 53.58,
   "t1": 57.38,
   "text": "两城相距 {5000} 斯塔德，乘以 {50}——"
  },
  {
   "id": "e6",
   "scene": "era1",
   "t0": 57.7,
   "t1": 61.1,
   "text": "地球一圈：{25 万}斯塔德。"
  },
  {
   "id": "e7",
   "scene": "era1",
   "t0": 61.42,
   "t1": 65.42,
   "text": "换成公里，约在 {3.9 万} 到 {4.6 万} 之间。"
  },
  {
   "id": "e8",
   "scene": "era1",
   "t0": 65.74,
   "t1": 69.14,
   "text": "离真实的 {4 万}，已经不远。"
  },
  {
   "id": "t1",
   "scene": "era2",
   "t0": 71.44,
   "t1": 74.84,
   "text": "将近一千年后，大唐流传着一个说法："
  },
  {
   "id": "t2",
   "scene": "era2",
   "t0": 75.16,
   "t1": 78.96,
   "text": "南北相隔{千里}，日影就差{一寸}。"
  },
  {
   "id": "t3",
   "scene": "era2",
   "t0": 79.28,
   "t1": 84.08,
   "text": "公元 724 年，南宫说在河南平原上，立起四根{八尺}表。"
  },
  {
   "id": "t4",
   "scene": "era2",
   "t0": 84.4,
   "t1": 88.6,
   "text": "夏至正午量影子：一根比一根{短}。"
  },
  {
   "id": "t5",
   "scene": "era2",
   "t0": 88.92,
   "t1": 93.12,
   "text": "从北到南 {526 里}，影子差了{二寸多}。"
  },
  {
   "id": "t6",
   "scene": "era2",
   "t0": 93.44,
   "t1": 97.64,
   "text": "照老说法，只该差半寸。史书的评语只有两个字："
  },
  {
   "id": "t7",
   "scene": "era2",
   "t0": 97.96,
   "t1": 100.56,
   "text": "{妄矣}。"
  },
  {
   "id": "t8",
   "scene": "era2",
   "t0": 100.88,
   "t1": 105.68,
   "text": "再看北极星：每往北 {351 里 80 步}，北极就高{一度}。"
  },
  {
   "id": "t9",
   "scene": "era2",
   "t0": 106.0,
   "t1": 109.8,
   "text": "这是史书里最早的{子午线实测}之一。"
  },
  {
   "id": "s1",
   "scene": "era3",
   "t0": 111.9,
   "t1": 115.7,
   "text": "可地球太大，没法拿尺子一步一步去量。"
  },
  {
   "id": "s2",
   "scene": "era3",
   "t0": 116.02,
   "t1": 119.42,
   "text": "1615 年，荷兰人斯涅尔换了个办法——"
  },
  {
   "id": "s3",
   "scene": "era3",
   "t0": 119.74,
   "t1": 123.54,
   "text": "只量{一条边}，其余全靠{角度}。"
  },
  {
   "id": "s4",
   "scene": "era3",
   "t0": 123.86,
   "t1": 128.46,
   "text": "以教堂塔尖为顶点，{33 个三角形}一路连下去。"
  },
  {
   "id": "s5",
   "scene": "era3",
   "t0": 128.78,
   "t1": 132.58,
   "text": "他给书起名叫：《荷兰的埃拉托色尼》。"
  },
  {
   "id": "s6",
   "scene": "era3",
   "t0": 132.9,
   "t1": 136.7,
   "text": "算出的地球，只比真实小了约 {3.4%}。"
  },
  {
   "id": "s7",
   "scene": "era3",
   "t0": 137.02,
   "t1": 141.02,
   "text": "1669 年，皮卡尔给测角仪装上了{望远镜}。"
  },
  {
   "id": "s8",
   "scene": "era3",
   "t0": 141.34,
   "t1": 145.94,
   "text": "巴黎附近，一度子午线：{57 060} 托阿斯，约 {111 公里}。"
  },
  {
   "id": "p1",
   "scene": "era4",
   "t0": 148.04,
   "t1": 151.44,
   "text": "可地球，真的是一个{圆球}吗？"
  },
  {
   "id": "p2",
   "scene": "era4",
   "t0": 151.76,
   "t1": 155.96,
   "text": "牛顿说：地球在自转，赤道会被{甩}得鼓起来——"
  },
  {
   "id": "p3",
   "scene": "era4",
   "t0": 156.28,
   "t1": 159.48,
   "text": "所以它是扁的，像个{橘子}。"
  },
  {
   "id": "p4",
   "scene": "era4",
   "t0": 159.8,
   "t1": 164.4,
   "text": "巴黎天文台的卡西尼却量出：地球是长的，像个{柠檬}。"
  },
  {
   "id": "p5",
   "scene": "era4",
   "t0": 164.72,
   "t1": 168.72,
   "text": "橘子，还是柠檬？法国派出了{两支远征队}。"
  },
  {
   "id": "p6",
   "scene": "era4",
   "t0": 169.04,
   "t1": 173.44,
   "text": "一队去{北极圈}的拉普兰，一队去{赤道}上的秘鲁。"
  },
  {
   "id": "p7",
   "scene": "era4",
   "t0": 173.76,
   "t1": 177.96,
   "text": "如果地球是扁的，越往北，{一度}就越{长}。"
  },
  {
   "id": "p8",
   "scene": "era4",
   "t0": 178.28,
   "t1": 182.68,
   "text": "北极圈那队一年就回来了；秘鲁那队，走了快{十年}。"
  },
  {
   "id": "p9",
   "scene": "era4",
   "t0": 183.0,
   "t1": 187.2,
   "text": "三个数摆在一起：越往北，一度{越长}。"
  },
  {
   "id": "p10",
   "scene": "era4",
   "t0": 187.52,
   "t1": 190.92,
   "text": "地球是扁的。{牛顿赢了}。"
  },
  {
   "id": "p11",
   "scene": "era4",
   "t0": 191.24,
   "t1": 194.64,
   "text": "伏尔泰写诗，挖苦凯旋的莫佩尔蒂："
  },
  {
   "id": "p12",
   "scene": "era4",
   "t0": 194.96,
   "t1": 199.36,
   "text": ""
  },
  {
   "id": "m1",
   "scene": "era5",
   "t0": 201.46,
   "t1": 206.26,
   "text": "1789 年，法国大革命。那时的尺子，换个镇子就不一样长。"
  },
  {
   "id": "m2",
   "scene": "era5",
   "t0": 206.58,
   "t1": 211.38,
   "text": "学者们提议：造一把{属于所有人}的尺子，从{地球}上量下来。"
  },
  {
   "id": "m3",
   "scene": "era5",
   "t0": 211.7,
   "t1": 216.5,
   "text": "从北极到赤道，分成{一千万}份——一份，就叫{一米}。"
  },
  {
   "id": "m4",
   "scene": "era5",
   "t0": 216.82,
   "t1": 221.62,
   "text": "1792 年，德朗布尔从敦刻尔克往南，梅尚从巴塞罗那往北。"
  },
  {
   "id": "m5",
   "scene": "era5",
   "t0": 221.94,
   "t1": 226.74,
   "text": "革命、战争，还被怀疑是{间谍}……这条线，他们量了{七年}。"
  },
  {
   "id": "m6",
   "scene": "era5",
   "t0": 227.06,
   "t1": 231.46,
   "text": "1799 年，一根铂金尺存进国家档案馆：{米原器}。"
  },
  {
   "id": "m7",
   "scene": "era5",
   "t0": 231.78,
   "t1": 236.58,
   "text": "可梅尚到死都藏着一个秘密：巴塞罗那的数据，{对不上}。"
  },
  {
   "id": "m8",
   "scene": "era5",
   "t0": 236.9,
   "t1": 241.3,
   "text": "后来人们算出，这把尺子比定义短了约 {0.2 毫米}。"
  },
  {
   "id": "z1",
   "scene": "end",
   "t0": 243.2,
   "t1": 247.8,
   "text": "1983 年起，米改由{光速}定义，长度特意保持不变。"
  },
  {
   "id": "z2",
   "scene": "end",
   "t0": 248.12,
   "t1": 252.32,
   "text": "所以，沿经线绕地球一圈，刚好约 {4 万公里}——"
  },
  {
   "id": "z3",
   "scene": "end",
   "t0": 252.64,
   "t1": 257.24,
   "text": "不是巧合：是人类先量了地球，再用地球{做了尺子}。"
  },
  {
   "id": "z4",
   "scene": "end",
   "t0": 257.56,
   "t1": 262.56,
   "text": "你手里的每一把尺子，都藏着{地球的尺寸}。"
  }
 ]
}